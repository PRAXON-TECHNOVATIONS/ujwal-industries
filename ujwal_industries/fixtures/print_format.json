  "html": "{% set copies = [ (\"Original\", \"e-Invoice\"), (\"Duplicate\", \"e-Invoice\"), (\"Triplicate\", \"e-Invoice\"), (\"Quadruplicate\",\n\"e-Invoice\") ] %} {# ── Pre-compute header values once ── #} {% set dn_name = doc.items[0].delivery_note if (doc.items\nand doc.items[0].delivery_note) else \"\" %} {% set dn_date = frappe.db.get_value(\"Delivery Note\", dn_name,\n\"posting_date\") if dn_name else None %} {% set eway_created= frappe.db.get_value(\"e-Waybill Log\", {\"reference_name\":\ndoc.name}, \"created_on\") %} {% set po_date = frappe.db.get_value(\"Sales Order\", doc.items[0].sales_order, \"po_date\") if\n(doc.items and doc.items[0].sales_order) else \"\" %} {% set addr = frappe.get_doc(\"Address\", doc.customer_address) if\ndoc.customer_address else None %} {% set ship = frappe.get_doc(\"Address\", doc.shipping_address_name) if\ndoc.shipping_address_name else None %} {% set cus = frappe.get_doc(\"Customer\", doc.customer) if doc.customer\nelse None %} {# ── QR Code ── #} {% set qr_src = \"\" %} {% if doc.irn %} {% set _log = frappe.get_doc(\"e-Invoice Log\",\ndoc.irn) %} {% if _log and _log.signed_qr_code %} {% set qr_src = \"data:image/png;base64,\" +\nget_qr_code(_log.signed_qr_code) %} {% endif %} {% endif %} {# ── Pagination (items split across pages) ── #} {% set ns\n= namespace(cur=[], h=0, pages=[]) %} {% for item in doc.items %} {% set nl = ((item.description or\n\"\")|string).count('\\n') %} {% set wr = (((item.description or \"\")|length) / 50)|int %} {% set lines = 1 + nl + wr %} {%\nif (ns.h + lines) > 25 %} {% set _ = ns.pages.append(ns.cur) %} {% set ns.cur = [item] %} {% set ns.h = lines %} {% else\n%} {% set _ = ns.cur.append(item) %} {% set ns.h = ns.h + lines %} {% endif %} {% endfor %} {% if ns.cur %}{% set _ =\nns.pages.append(ns.cur) %}{% endif %} {# ── 4 copies × N pages ── #} {% set outer = namespace(last_copy=false) %} {% for\ncopy_label, copy_sub in copies %} {% set outer.last_copy = loop.last %} {% for batch in ns.pages %} {% set is_last =\nloop.last %} {% set needs_break = (not is_last) or (not outer.last_copy) %} <div\n    class=\"spring-container {% if needs_break %}page-break{% endif %}\">\n    <div class=\"content-wrapper\"> <!-- ═══════════ HEADER 4.8 cm ═══════════ -->\n        <table style=\"width:100%;border-collapse:collapse;border:1px solid #000;height:4.8cm;table-layout:fixed;\">\n            <tr> <!-- Logo + company info (45%) -->\n                <td style=\"width:45%;vertical-align:top;padding:5px;border:none;\">\n                    <div style=\"margin-top:1cm;padding-right:30px;\"> <img src=\"/files/ujwal.png\"\n                            style=\"height:1.8cm;width:5.5cm;object-fit:contain;\"> </div>\n                    <div style=\"font-size:8.5px;line-height:1.4;margin-top:4px;\"> <b>Works :</b> Plot No. W-53 &amp;\n                        W-53/1, Phase II, MIDC Dombivli (E),<br> Dist. Thane - 421204, MS - INDIA.<br> <b>Tel:</b>\n                        91-9833390161 / 91-8691055543<br> <b>Email:</b> sales.ujwal@ivisiongroup.co.in<br> <b\n                            style=\"font-size:10.5px;\">GSTIN No : 27ADZPB3303R1Z0</b> </div>\n                </td> <!-- TAX-INVOICE + IRN (32%) -->\n                <td style=\"width:32%;vertical-align:top;border:none;padding:5px;\">\n                    <div\n                        style=\"font-size:16px;font-weight:bold;display:inline-block;text-align:center\">\n                        TAX-INVOICE</div>\n                    <div style=\"font-size:10px;font-weight:bold;text-align:left;margin-top:2px;\">Under Rule 7 of GST Rules 2017</div>\n                    <div style=\"margin-top:8px;font-size:8px;font-weight:bold;\"> IRN NO:<br> <span\n                            style=\"font-size:7px;word-break:break-all;line-height:1.2;display:block;\">{{\n                            doc.irn or \"\" }}</span> </div>\n                </td> <!-- Copy label + QR + IRN DT (23%) -->\n                <td style=\"width:23%;vertical-align:top;padding:5px;border:none;text-align:right;\">\n                    <div style=\"font-size:9px;\">{{ copy_label }}</div>\n                    <div style=\"font-size:11px;font-weight:bold;\">{{ copy_sub }}</div>\n                    <div style=\"margin-top:4px;text-align:left;margin-left:4px;\"> {% if qr_src %} <img\n                            src=\"{{ qr_src }}\" style=\"width:2.6cm;height:2.6cm;object-fit:contain;display:block;\"> {%\n                        else %} <div\n                            style=\"width:2.6cm;height:2.6cm;border:1px dashed #aaa;font-size:7px;color:#aaa;display:inline-flex;align-items:center;justify-content:center;text-align:center;\">\n                            QR NOT<br>GENERATED</div> {% endif %} <div style=\"font-size:8px;margin-top:3px;\"><b>IRN DT:\n                                {{ frappe.utils.formatdate(doc.posting_date,\"dd-MMM-yyyy\")|upper }}</b></div>\n                    </div>\n                </td>\n            </tr>\n        </table> <!-- ═══════════ INFO BAND ═══════════ --> <!-- Row 1: Goods Division / Invoice No / Date ~0.9 cm -->\n        <table class=\"master-table\" style=\"border-top:none;\">\n            <tr style=\"height:0.9cm;\">\n                <td width=\"45.5%\" class=\"text-bold\">Name of Goods Division: {{ doc.custom_name_of_goods_division or\n                    \"SWITCHGEAR\" }}</td>\n                <td width=\"19.5%\" class=\"text-bold\">INVOICE NO</td>\n                <td width=\"17.5%\">{{ doc.name }}</td>\n                <td width=\"5%\" class=\"text-bold\">Date</td>\n                <td width=\"12.5%\">{{ frappe.utils.formatdate(doc.posting_date,\"dd-MM-yyyy\") }}</td>\n            </tr> <!-- Row 2: Consignee + PO info 2.5 cm -->\n            <tr style=\"height:2.5cm;\">\n                <td width=\"45.5%\" style=\"vertical-align:top;padding:4px;\">\n                    <div style=\"font-size:9px;font-weight:bold;\">Name &amp; Address of Consignee:</div> {% if cus %}\n                    <div style=\"font-size:10.5px;font-weight:bold;margin:3px 0;\">{{ cus.custom_customer_names or\n                        cus.customer_name }}</div> {% endif %} {% if addr %} <div\n                        style=\"font-size:9px;line-height:1.3;\">{{ addr.address_line1 or \"\" }} {{ addr.address_line2 or\n                        \"\" }} {{ addr.state or \"\" }} {{ addr.pincode or \"\" }}</div>\n                    <div style=\"margin-top:8px;font-size:13px;\">GST No. : <b>{{ addr.gstin or \"\" }}</b></div> {% endif\n                    %}\n                </td>\n                <td width=\"19.5%\" class=\"text-bold\" style=\"padding:3px !important;vertical-align:top;\">\n                    <div style=\"border-bottom:1px solid #000;height:0.5cm;line-height:0.5cm;\">PO NO</div>\n                    <div style=\"border-bottom:1px solid #000;height:0.5cm;line-height:0.5cm;\">Our Challan No.</div>\n                    <div style=\"border-bottom:1px solid #000;height:0.5cm;line-height:0.5cm;\">G.R.N No.</div>\n                    <div style=\"border-bottom:1px solid #000;height:0.5cm;line-height:0.5cm;\">EWay Bill No.</div>\n                    <div style=\"height:0.5cm;line-height:0.5cm;\">Vendor Code No</div>\n                </td>\n                <td width=\"17%\" style=\"padding:3px !important;vertical-align:top;\">\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{ doc.po_no or \"&nbsp;\" }}</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{ dn_name or \"&nbsp;\" }}</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{ doc.grn_no or \"&nbsp;\" }}</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{ doc.ewaybill or \"&nbsp;\" }}</div>\n                    <div style=\"padding:2px 0;\">{{ doc.vendor_code or \"&nbsp;\" }}</div>\n                </td>\n                <td width=\"5.25%\" style=\"padding:3px !important;vertical-align:top;text-align:center;\">\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">Date</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">Date</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">Date</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">Date</div>\n                </td>\n                <td width=\"12.75%\" style=\"padding:3px !important;vertical-align:top;\">\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{\n                        frappe.utils.formatdate(po_date,\"dd-MM-yyyy\") if po_date else \"&nbsp;\" }}</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{\n                        frappe.utils.formatdate(dn_date,\"dd-MM-yyyy\") if dn_date else \"&nbsp;\" }}</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">&nbsp;</div>\n                    <div style=\"border-bottom:1px solid #000;padding:2px 0;\">{{\n                        frappe.utils.formatdate(eway_created,\"dd-MM-yyyy\") if eway_created else \"&nbsp;\" }}</div>\n                </td>\n            </tr>\n        </table> <!-- ═══════════ ITEMS TABLE ═══════════ -->\n        <table style=\"width:100%;border-collapse:collapse;border:1px solid #000;border-top:none;table-layout:fixed;\">\n            <thead>\n                <tr class=\"text-center text-bold\" style=\"height:0.55cm;\">\n                    <td rowspan=\"2\" style=\"width:5%;padding:3px;border:1px solid #000;\">Pos n<br>No.</td>\n                    <td rowspan=\"2\" style=\"width:30%;padding:3px;border:1px solid #000;\">PARTICULAR /<br>Description of\n                        Goods</td>\n                    <td rowspan=\"2\" style=\"width:10.5%;padding:3px;border:1px solid #000;\">HSN</td>\n                    <td colspan=\"2\" style=\"width:19.5%;padding:3px;border:1px solid #000;\">PACKING</td>\n                    <td rowspan=\"2\" style=\"width:10%;padding:3px;border:1px solid #000;\">QTY</td>\n                    <td rowspan=\"2\" style=\"width:7.5%;padding:3px;border:1px solid #000;\">Rate<br>(&#8377;)</td>\n                    <td rowspan=\"2\" style=\"width:17.5%;padding:3px;border:1px solid #000;\">Amt<br>(&#8377;)</td>\n                </tr>\n                <tr class=\"text-center text-bold\" style=\"height:0.45cm;\">\n                    <td style=\"border:1px solid #000;padding:2px;\">No of<br>Pkgs</td>\n                    <td style=\"border:1px solid #000;padding:2px;\">Avg<br>cont.</td>\n                </tr>\n            </thead>\n            <tbody> {% for row in batch %} <tr style=\"min-height:0.9cm;\">\n                    <td class=\"text-center\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{\n                        row.custom_po_no or \"\" }}</td>\n                    <td style=\"vertical-align:top;border:1px solid #000;padding:3px;\"> <b>{{ row.item_name }}</b> {% if\n                        row.description %}<br><span style=\"font-size:8px;color:#333;\">{{ row.description }}</span>{%\n                        endif %} </td>\n                    <td class=\"text-center\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{\n                        row.gst_hsn_code or \"\" }}</td>\n                    <td class=\"text-center\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{\n                        row.custom_no_of_packages or \"\" }}</td>\n                    <td class=\"text-center\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{\n                        row.custom_avg_content or \"\" }}</td>\n                    <td class=\"text-center\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\"> {{\n                        \"{:,.0f}\".format(row.qty|float) }}<br><span style=\"font-size:8px;\">{{ row.uom }}</span> </td>\n                    <td class=\"text-right\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{ row.rate or\n                        \"\" }}</td>\n                    <td class=\"text-right\" style=\"border:1px solid #000;padding:3px;vertical-align:top;\">{{\n                        \"{:,.0f}\".format(row.amount|float) }}</td>\n                </tr> {% endfor %} {# Filler rows – 1.1 cm each #} {% set filler = 5 - (batch|length) %} {% if filler >\n                0 %} {% for i in range(filler) %} <tr style=\"height:1.1cm;\">\n                    <td style=\"border-left:1px solid #000;border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                    <td style=\"border-right:1px solid #000;\"></td>\n                </tr> {% endfor %} {% endif %} </tbody>\n        </table>\n    </div>{# end content-wrapper #} <!-- ═══════════ FOOTER ═══════════ -->\n    <div class=\"footer-wrapper\"> {% if is_last %} {# ── Tax computation ── #} {% set t =\n        namespace(cgst=0,cgst_rate=0,sgst=0,sgst_rate=0,igst=0,igst_rate=0,tcs=0,tcs_rate=1) %} {% for tax in doc.taxes\n        %} {% if \"CGST\" in (tax.account_head or \"\") %} {% set t.cgst = t.cgst + tax.tax_amount %}{% set t.cgst_rate =\n        tax.rate %} {% elif \"SGST\" in (tax.account_head or \"\") %} {% set t.sgst = t.sgst + tax.tax_amount %}{% set\n        t.sgst_rate = tax.rate %} {% elif \"IGST\" in (tax.account_head or \"\") %} {% set t.igst = t.igst + tax.tax_amount\n        %}{% set t.igst_rate = tax.rate %} {% elif \"TCS\" in (tax.account_head or \"\") or \"TCS\" in (tax.description or \"\")\n        %} {% set t.tcs = t.tcs + tax.tax_amount %}{% set t.tcs_rate = tax.rate %} {% endif %} {% endfor %}\n        <!-- ── Main footer row: left words + right tax summary ── -->\n        <table class=\"master-table\" style=\"border-top:none;\">\n            <tr> <!-- LEFT 65%: amount words + ship to -->\n                <td width=\"65%\" style=\"padding:0!important;vertical-align:top;border-right:1px solid #000;\">\n                    <!-- Base amount -->\n                    <div\n                        style=\"padding:4px 5px;border-bottom:1px solid #000;font-size:9.5px;min-height:0.9cm;box-sizing:border-box;font-weight:bold;\">\n                        {{ doc.base_in_words|upper }} </div> <!-- CGST -->\n                    <div style=\"padding:2px 5px;border-bottom:1px solid #000;font-size:7.5px;font-weight:bold;min-height:0.4cm;box-sizing:border-box;\"\n                        class=\"text-uppercase\"> CGST : {{ frappe.utils.in_words(t.cgst) if t.cgst > 0 else \"NIL\" }}\n                    </div> <!-- SGST -->\n                    <div style=\"padding:2px 5px;border-bottom:1px solid #000;font-size:7.5px;font-weight:bold;min-height:0.4cm;box-sizing:border-box;\"\n                        class=\"text-uppercase\"> SGST : {{ frappe.utils.in_words(t.sgst) if t.sgst > 0 else \"NIL\" }}\n                    </div> <!-- IGST -->\n                    <div style=\"padding:2px 5px;border-bottom:1px solid #000;font-size:7.5px;font-weight:bold;min-height:0.4cm;box-sizing:border-box;\"\n                        class=\"text-uppercase\"> IGST : {{ frappe.utils.in_words(t.igst) if t.igst > 0 else \"NIL\" }}\n                    </div> <!-- TCS -->\n                    <div style=\"padding:2px 5px;border-bottom:1px solid #000;font-size:7.5px;font-weight:bold;min-height:0.4cm;box-sizing:border-box;\"\n                        class=\"text-uppercase\"> TCS : {{ frappe.utils.in_words(t.tcs) if t.tcs > 0 else \"\" }} </div>\n                    <!-- Amount In Words -->\n                    <div\n                        style=\"padding:2px 5px;border-bottom:1px solid #000;font-size:8px;font-weight:bold;min-height:0.6cm;box-sizing:border-box;\">\n                        Amount In Words : {{ doc.in_words }} </div> <!-- Ship To Party -->\n                    <div style=\"padding:5px;min-height:2.5cm;font-size:9px;\"> <b>Ship To Party :</b> {% if ship %} {{\n                        ship.address_line1 or \"\" }} {{ ship.address_line2 or \"\" }} {{ ship.state or \"\" }} <div\n                            style=\"margin-top:4px;\"><b>GSTIN : {{ ship.gstin or \"\" }}</b></div> {% endif %} </div>\n                </td> <!-- RIGHT 35%: tax summary table -->\n                <td width=\"35%\" style=\"padding:0;vertical-align:top;\">\n                    <table style=\"width:100%;border-collapse:collapse;font-size:8.5px;\">\n                        <tr style=\"height:0.45cm;\">\n                            <td width=\"60%\" class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">\n                                Assessable Value</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(doc.base_net_total|float) }}</td>\n                        </tr>\n                        <tr style=\"height:0.45cm;\">\n                            <td class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">Other Charges\n                            </td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">0.000\n                            </td>\n                        </tr>\n                        <tr style=\"height:0.45cm;\">\n                            <td class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">CGST @ {{\n                                t.cgst_rate }}%</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(t.cgst|float) }}</td>\n                        </tr>\n                        <tr style=\"height:0.45cm;\">\n                            <td class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">SGST @ {{\n                                t.sgst_rate }}%</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(t.sgst|float) }}</td>\n                        </tr>\n                        <tr style=\"height:0.45cm;\">\n                            <td class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">IGST @ {{\n                                t.igst_rate }}%</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(t.igst|float) }}</td>\n                        </tr>\n                        <tr style=\"height:0.45cm;\">\n                            <td class=\"text-bold\" style=\"padding:2px 4px;border-bottom:1px solid #000;\">TCS @ {{\n                                t.tcs_rate }}%</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(t.tcs|float) }}</td>\n                        </tr>\n                        <tr style=\"height:0.5cm;font-weight:bold;\">\n                            <td style=\"padding:2px 4px;border-bottom:1px solid #000;\">Total Amount</td>\n                            <td class=\"text-right\"\n                                style=\"padding:2px 4px;border-bottom:1px solid #000;border-left:1px solid #000;\">{{\n                                \"{:,.3f}\".format(doc.grand_total|float) }}</td>\n                        </tr>\n                        <tr style=\"height:1.4cm;\">\n                            <td colspan=\"2\" style=\"padding:4px;vertical-align:top;font-weight:bold;font-size:8.5px;\">\n                                Mode of Transport Vehicle No :- {{ doc.vehicle_no or \"\" }} </td>\n                        </tr>\n                    </table>\n                </td>\n            </tr>\n        </table> <!-- ── HSN / Tax table – dynamic CGST+SGST or IGST ── --> {% if t.igst > 0 %}\n        <!-- Inter-state: Integrated Tax -->\n        <table class=\"master-table\">\n            <tr class=\"text-center text-bold\" style=\"background:#eee;height:0.5cm;\">\n                <td rowspan=\"2\" width=\"16%\">HSN/SAC</td>\n                <td rowspan=\"2\" width=\"22%\">Taxable Value</td>\n                <td colspan=\"2\">Integrated Tax</td>\n                <td rowspan=\"2\" width=\"18%\">Total Tax Amount</td>\n            </tr>\n            <tr class=\"text-center text-bold\" style=\"background:#eee;height:0.5cm;\">\n                <td width=\"12%\">Rate</td>\n                <td width=\"14%\">Amount</td>\n            </tr> {% for group in doc.items|groupby(\"gst_hsn_code\") %} {% set gv = namespace(net=0) %} {% for item in\n            group.list %}{% set gv.net = gv.net + item.net_amount %}{% endfor %} {% set igst_amt = gv.net * t.igst_rate\n            / 100 %} <tr class=\"text-right\" style=\"height:0.6cm;\">\n                <td class=\"text-center\">{{ group.grouper }}</td>\n                <td>{{ \"{:,.3f}\".format(gv.net|float) }}</td>\n                <td class=\"text-center\">{{ \"%.2f\"|format(t.igst_rate) }}</td>\n                <td>{{ \"{:,.3f}\".format(igst_amt|float) }}</td>\n                <td>{{ \"{: