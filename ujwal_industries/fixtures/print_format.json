  "html": "<html>\n<head>\n</head>\n\n<body>\n    {% if doc.stock_entry_type == \"Material Transfer for Manufacture\"%}\n        <table width=\"100%\">\n            <tr style=\"border:2px solid black;\">\n                <td style=\"text-align:center;\"><b>Material Issue Slip</b></td>\n            </tr>\n        </table>\n        \n        <br>\n        \n        <table width=\"100%\">\n            <tr>\n                <td width=\"25%\" style=\"border:1px solid black;\"><b>Order Number</b></td>\n                <td style=\"border:1px solid black;\"><b>{{doc.work_order or \"\"}}</b></td>\n            </tr>\n        \n            <tr>\n                <td width=\"25%\" style=\"border:1px solid black;\"><b>Reservation Number</b></td>\n                <td style=\"border:1px solid black;\"><b>{{doc.work_order or \"\"}}</b></td>\n            </tr>\n        \n            <tr>\n                <td width=\"25%\" style=\"border:1px solid black;\"><b>Requirement Date</b></td>\n                <td style=\"border:1px solid black;\"><b>{{doc.get_formatted('posting_date') or \"\"}}</b></td>\n            </tr>\n        </table>\n        \n        <br>\n        \n        {% set wo = frappe.get_doc(\"Work Order\",doc.work_order) %}\n        {% set item = frappe.get_doc(\"Item\",wo.production_item) %}\n        \n        <table width=\"100%\">\n            <tr>\n                <td width=\"25%\" style=\"border:1px solid black;\"><b>FG/SEG Material</b></td>\n                <td width=\"25%\" style=\"border:1px solid black;\">{{wo.production_item or \"\"}}</td>\n        \n                <td width=\"25%\" style=\"border:1px solid black;\"><b>FG/SFG Material Des</b></td>\n                <td width=\"25%\" style=\"border:1px solid black;\">{{wo.item_name or \"\"}}</td>\n            </tr>\n        \n            <tr>\n                <td style=\"border:1px solid black;\"><b>FG/SFG Quantity</b></td>\n                <td style=\"border:1px solid black;\">{{wo.qty or \"\"}}</td>\n        \n                <td style=\"border:1px solid black;\"><b>Unit of Measurement</b></td>\n                <td style=\"border:1px solid black;\">{{item.stock_uom or \"\"}}</td>\n            </tr>\n        </table>\n        \n        <br><br>\n        \n        <table width=\"100%\">\n            <tr>\n                <td width=\"9%\" style=\"border:1px solid black;\"><b>Item No.</b></td>\n                <td width=\"13%\" style=\"border:1px solid black;\"><b>Material No.</b></td>\n                <td style=\"border:1px solid black;\"><b>Material Description</b></td>\n                <td width=\"11%\" style=\"border:1px solid black;\"><b>Req Qty</b></td>\n                <td width=\"6%\" style=\"border:1px solid black;\"><b>UOM</b></td>\n                <td style=\"border:1px solid black;\"><b>Plant</b></td>\n                <td width=\"13%\" style=\"border:1px solid black;\"><b>SLOC</b></td>\n                <td style=\"border:1px solid black;\"><b>D/C</b></td>\n                <td style=\"border:1px solid black;\"><b>User Id</b></td>\n            </tr>\n        \n            {% for i in doc.items %}\n            <tr>\n                <td style=\"border:1px solid black;\">{{loop.index}}</td>\n                <td style=\"border:1px solid black;\">{{i.item_code or \"\"}}</td>\n                <td style=\"border:1px solid black;\">{{i.description or \"\"}}</td>\n                <td style=\"border:1px solid black;\">{{i.qty or \"\"}}</td>\n                <td style=\"border:1px solid black;\">{{i.uom or \"\"}}</td>\n                <td style=\"border:1px solid black;\">{{doc.company or \"\"}}</td>\n                <td style=\"border:1px solid black;\">{{i.s_warehouse or \"\"}}</td>\n                <td style=\"border:1px solid black;\"></td>\n                <td style=\"border:1px solid black;\">\n                    {% set user = frappe.get_doc(\"User\",doc.owner) %}\n                    {{user.full_name or \"\"}}\n                </td>\n            </tr>\n            {% endfor %}\n        \n        </table>\n    {% endif %}\n</body>\n</html>",
