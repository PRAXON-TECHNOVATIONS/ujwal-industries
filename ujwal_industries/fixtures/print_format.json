                   {% set so = frappe.get_doc(\"Sales Order\", doc.items[0].against_sales_order) %}\n                        {{so.get_formatted('po_date') or \"\"}}\n                        \n                    {% endif%}\n                </td>\n               \n            </tr>\n            \n            <tr style=\"font-size:13px;\">\n                \n                <td width=\"\">Yr Chal No.</td>\n                <td width=\"\">:</td>\n                <td width=\"\">{{doc.custom_yr_chal_no or\"\"}}</td>\n                \n                <td width=\"\">YR Chal Date</td>\n                <td width=\"\">:</td>\n                <td width=\"\" style=\"border-right:1px solid black;\">{{doc.get_formatted('posting_date') or \"\"}}</td>\n               \n            </tr>\n            \n            <tr style=\"font-size:13px;\">\n                <td width=\"\" style=\"border-left:1px solid black;\">GST No.</td>\n                <td width=\"\" style=\"\">:</td>\n                <td colspan=\"7\" width=\"\" style=\"border-right:1px solid black;\">\n                    {% if doc.customer_address %}\n                        {% set cust_add = frappe.get_doc(\"Address\",doc.customer_address) %}\n                        {{cust_add.gstin or \"\" }}\n                    {% endif %}\n                </td>\n            </tr>\n            \n            <tr style=\"font-size:13px;\">\n                <td width=\"15%\" style=\"border-left:1px solid black;\">Our Code No.</td>\n                <td width=\"1%\" style=\"\">:</td>\n                <td colspan=\"7\" width=\"30%\" style=\"border-right:1px solid black;\"></td>\n            </tr>\n            \n            <tr style=\"font-size:13px;\">\n                <td width=\"\" style=\"border-left:1px solid black; border-bottom:1px solid black;\">Invoice No.</td>\n                <td width=\"\" style=\"border-bottom:1px solid black;\">:</td>\n                <td width=\"\" style=\"border-bottom:1px solid black;\">\n                    {% if doc.items and doc.items[0].against_sales_invoice %}\n                    {% set so = frappe.get_doc(\"Sales Invoice\", doc.items[0].against_sales_invoice) %}\n                    {{ so.name or \"\" }}\n                    {% endif %}\n                </td>\n                \n                <td width=\"\" style=\"border-bottom:1px solid black;\">Date</td>\n                <td width=\"\" style=\"border-bottom:1px solid black;\">:</td>\n                <td colspan=\"4\" width=\"\" style=\"border-bottom:1px solid black; border-right:1px solid black;\">\n                    {% if doc.items and doc.items[0].against_sales_invoice %}\n                    {% set so = frappe.get_doc(\"Sales Invoice\", doc.items[0].against_sales_invoice) %}\n                    {{ so.get_formatted('posting_date') or \"\" }}\n                    {% endif %}\n                </td>\n            </tr>\n            \n            <tr>\n                <td colspan=\"9\" style=\"font-size:13px; border-right:1px solid black; border-left:1px solid black; text-align:center;\">\n                    Please receive the following goods in good order & conditions & return the duplicate duly signed\n                </td>\n            </tr>\n            \n            \n        </table>\n        <table width=\"100%\">\n            <tr style=\"border:1px solid black; font-weight: bold; text-align:center;\">\n                <td width=\"8%\" style=\"border:1px solid black;\">Pos.No.</td>\n                <td style=\"border:1px solid black\">Item Code/ Description</td>\n                <td width=\"20%\" style=\"border:1px solid black;\">Quantity</td>\n            </tr>\n            \n            {% set loop_idx = {'value': 1} %}\n            {% for i in doc.items %}\n            <tr style=\"\">\n                <td width=\"8%\" style=\" border-left:1px solid black; border-right:1px solid black; text-align:center;\">\n                    {{loop.index}}\n                </td>\n                <td style=\"border-right:1px solid black; \">[{{i.item_code or \"\"}}] {{i.description or \"\"}} | Batch No :</td>\n                <td width=\"20%\" style=\"border-right:1px solid black; border-right:1px solid black; text-align:center;\">\n                    {{i.qty or\"\"}} {{i.uom or \"\"}}\n                </td>\n            </tr>\n            {% if loop_idx.update({'value': loop_idx['value'] + 1}) %}{% endif %}\n            {% endfor %}\n            \n            \n            {% if doc.items | length < 28 %}\n            {% set looprange = 28 - doc.items | length %}\n            {% for i in range(looprange) %}\n            <tr style=\"\">\n                <td width=\"8%\" style=\" border-left:1px solid black; border-right:1px solid black; text-align:center;\"></td>\n                <td style=\"border-right:1px solid black; \"></td>\n                <td width=\"20%\" style=\"border-right:1px solid black; border-right:1px solid black; text-align:center; \"></td>\n            </tr>\n            {% endfor %}\n            {% endif %}\n        </table>\n        <table width=\"100%\">\n            <tr style=\"text-align:center; border-left:1px solid black; border-right:1px solid black; border-bottom:1px solid black; border-top:1px solid black;\">\n                <td width=\"50%\" style=\"border-right:1px solid black; vertical-align:bottom; border-top:1px solid black;\">\n                    <br><br><br>\n                    {% set user = frappe.get_doc(\"User\", doc.modified_by) %}\n                    {{user.full_name or \"\"}}\n                    <br>Receiver's Signature<br>(With Rubber Stamp)</td>\n                <td width=\"50%\"><b><br><br><br><br>FOR UJWAL INDUSTRIES</b></td>\n            </tr>\n        </table>\n    </head>\n</html>",
